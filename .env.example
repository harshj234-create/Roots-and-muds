# Copy these into Vercel → your project → Settings → Environment Variables.
# Only ADMIN_PASSWORD and DATABASE_URL are required to take orders.

# --- Required ---
ADMIN_PASSWORD=choose-a-long-password
# Added automatically when you connect a Neon Postgres database in Vercel → Storage
DATABASE_URL=

# --- Recommended ---
SITE_URL=https://rootsandmuds.ae
# Any long random text; keeps admin logins secure
ADMIN_SESSION_SECRET=

# --- Order email (resend.com) ---
RESEND_API_KEY=
ORDER_EMAIL_TO=you@example.com
ORDER_EMAIL_FROM=Roots and Muds <orders@rootsandmuds.ae>

# --- Order WhatsApp message (callmebot.com) ---
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=971505506800

# --- Google Sheet (Apps Script web app, see README) ---
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=
